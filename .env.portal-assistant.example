# Portal Assistant — Copilot Studio connection
#
# Copy to .env.local and fill in. Restart the dev server after editing.
# None of these are secrets. There is no client secret in this integration.

# --- Copilot Studio -> Portal Assistant 2 -> Settings -> Advanced -> Metadata ---
NEXT_PUBLIC_COPILOT_ENVIRONMENT_ID=
NEXT_PUBLIC_COPILOT_SCHEMA_NAME=
NEXT_PUBLIC_COPILOT_TENANT_ID=

# --- Entra app registration -> Overview -> Application (client) ID ---
# Needs: API permissions -> Power Platform API -> Delegated ->
#        Copilot Studio -> CopilotStudio.Copilots.Invoke  (admin consent granted)
# Needs: Authentication -> Add a platform -> Single-page application
#        with redirect URIs for localhost and production
NEXT_PUBLIC_COPILOT_APP_CLIENT_ID=

# Optional. Defaults to window.location.origin, which is usually what you want.
# Set it only if you need to pin a specific registered redirect URI.
# NEXT_PUBLIC_COPILOT_REDIRECT_URI=https://icna-relief-portal.vercel.app
